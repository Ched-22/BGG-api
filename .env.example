DATABASE_URL="postgresql://user:password@localhost:5432/bgggarage?schema=public"
JWT_SECRET="change-me-in-production"
GOOGLE_CLIENT_ID="your-google-oauth-web-client-id.apps.googleusercontent.com"
# Base URLs for password reset links (no trailing slash)
ADMIN_APP_URL="http://localhost:5173"
MOBILE_APP_URL="http://localhost:5174"
# Optional IBAN shown in Admin payment card (Multibanco / transferência)
BGG_PAYMENT_IBAN=""
# When true in non-production, forgot-password returns debugResetUrl in the response
PASSWORD_RESET_DEBUG="true"
# One-shot BRL→EUR rate for legacy data migration (default 0.18)
BRL_TO_EUR_RATE="0.18"

# Media upload (vehicle inspection photos)
MEDIA_STORAGE="local"
MEDIA_LOCAL_PATH="uploads"
MEDIA_PUBLIC_BASE_URL="http://localhost:3000"

# Seed passwords (optional — defaults: admin123 / tecnico123)
# SEED_ADMIN_EMAIL="admin@bgggarage.com"
# SEED_ADMIN_PASSWORD="admin123"
# SEED_TECHNICIAN_PASSWORD="tecnico123"

# Weekly report email (SMTP or Resend + cron)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Alternative to SMTP (e.g. Resend): RESEND_API_KEY=re_xxx
# RESEND_API_KEY=
MAIL_FROM="Black Gold Garage <noreply@bgggarage.com>"
WEEKLY_REPORT_CRON_ENABLED=true
# Staging/dev: redirect all weekly report emails (until production SMTP)
WEEKLY_REPORT_EMAIL_OVERRIDE=pedro@devdeals.app

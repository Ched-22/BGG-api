generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECHNICIAN
}

enum QuoteStatus {
  DRAFT
  PENDING
  APPROVED
}

enum AppointmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password      String?
  googleId      String?  @unique
  role          Role     @default(TECHNICIAN)
  active        Boolean  @default(true)
  phoneCountryCode    String?
  phoneNationalNumber String?
  startedAt     DateTime?
  skills        String[] @default([])
  available     Boolean  @default(true)
  scheduleLabel String?
  workloadHours Int      @default(0)
  createdAt     DateTime @default(now())
  appointments  Appointment[]
  quotes        Quote[]  @relation("QuoteCreatedBy")
  passwordResetTokens PasswordResetToken[]
  inAppNotifications InAppNotification[]
  technicianServices TechnicianService[]
  employeeCost       EmployeeCost?
}

model InAppNotification {
  id          String    @id @default(uuid())
  recipientId String
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        String
  title       String
  body        String
  severity    String    @default("info")
  readAt      DateTime?
  resolvedAt  DateTime?
  meta        Json?
  action      Json?
  createdAt   DateTime  @default(now())

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([recipientId, readAt])
}

model WeeklyReportLog {
  id         String   @id @default(uuid())
  weekStart  String   @unique
  weekEnd    String
  metrics    Json
  recipients String[]
  sentAt     DateTime
  createdAt  DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum ClientPreferredLanguage {
  es
  ca
  en
  ptBr
  ptPt
}

model Client {
  id                  String    @id @default(uuid())
  name                String
  phoneCountryCode    String
  phoneNationalNumber String
  email               String?
  preferredLanguage   ClientPreferredLanguage @default(es)
  status      String    @default("Ativo")
  addressUnit String?
  street      String?
  city        String?
  state       String?
  zipCode     String?
  notes       String?
  createdAt   DateTime  @default(now())
  vehicles    Vehicle[]
  tasks       Task[]
}

model Vehicle {
  id           String       @id @default(uuid())
  plate        String       @unique
  plateCountry String       @default("ES")
  brand        String
  model        String
  year         Int
  color        String?
  clientId     String
  client       Client       @relation(fields: [clientId], references: [id])
  appointments Appointment[]
}

enum ServiceCategory {
  EXTERIOR
  INTERIOR
  COMPLETE
  MOTO
}

model CatalogService {
  id              String                @id @default(uuid())
  code            String                @unique
  name            String
  description     String?
  durationMinutes Int
  serviceCategory ServiceCategory       @map("service_category")
  active          Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  prices          CatalogServicePrice[]
  technicians     TechnicianService[]
}

model CatalogServicePrice {
  id               String         @id @default(uuid())
  catalogServiceId String
  catalogService   CatalogService @relation(fields: [catalogServiceId], references: [id], onDelete: Cascade)
  priceSmall       Float
  priceMedium      Float
  priceLarge       Float
  effectiveFrom    DateTime       @default(now())
  effectiveTo      DateTime?
  createdAt        DateTime       @default(now())

  @@index([catalogServiceId, effectiveFrom(sort: Desc)])
}

model TechnicianService {
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogServiceId String
  catalogService   CatalogService @relation(fields: [catalogServiceId], references: [id], onDelete: Cascade)

  @@id([userId, catalogServiceId])
}

model Appointment {
  id          String            @id @default(uuid())
  scheduledAt DateTime
  status      AppointmentStatus @default(PENDING)
  notes       String?
  vehicleId   String
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id])
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  checklist   Checklist?
  createdAt   DateTime          @default(now())
}

model Checklist {
  id            String           @id @default(uuid())
  appointmentId String           @unique
  appointment   Appointment      @relation(fields: [appointmentId], references: [id])
  notes         String?
  completedAt   DateTime?
  items         ChecklistItem[]
}

model ChecklistItem {
  id          String    @id @default(uuid())
  description String
  done        Boolean   @default(false)
  photoUrl    String?   // URL do S3
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id])
}

enum InspectionReportStatus {
  DRAFT
  PENDING_REVIEW
  SENT_TO_CLIENT
}

model VehicleInspection {
  id                   String                   @id @default(uuid())
  appointmentId        String?                  @unique
  taskDisplayId        String?                  @unique
  entryData            Json                     @default("{}")
  exitData             Json                     @default("{}")
  entryFinalizedAt     DateTime?
  exitFinalizedAt      DateTime?
  reportStatus         InspectionReportStatus   @default(DRAFT)
  submittedForReviewAt DateTime?
  sentToClientAt       DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
}

model InventoryProduct {
  id              String   @id @default(uuid())
  sku             String   @unique
  name            String
  category        String
  unit            String
  currentQuantity Int      @default(0)
  maxCapacity     Int
  unitCost        Float    @default(0)
  supplier        String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  consumptions    InventoryConsumption[]
  movements       InventoryMovement[]
}

enum InventoryMovementType {
  CREATED
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DEACTIVATED
}

model InventoryMovement {
  id               String                 @id @default(uuid())
  productId        String
  product          InventoryProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  type             InventoryMovementType
  quantityBefore   Int
  quantityAfter    Int
  quantityDelta    Int
  unitCostSnapshot Float
  note             String?
  actorId          String?
  actorName        String
  occurredAt       DateTime               @default(now())
  createdAt        DateTime               @default(now())

  @@index([productId])
  @@index([occurredAt])
}

model InventoryConsumption {
  id               String           @id @default(uuid())
  productId        String
  product          InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityConsumed Int
  unitCostSnapshot Float
  totalCost        Float
  consumedAt       DateTime         @default(now())

  @@index([consumedAt])
  @@index([productId])
}

model FinanceExpense {
  id         String   @id @default(uuid())
  label      String
  category   String
  amount     Float
  occurredAt DateTime
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([occurredAt])
}

model EmployeeCost {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyCost   Float
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Task {
  id                 String   @id @default(uuid())
  displayId          String   @unique
  projeto            String
  cliente            String
  clienteEmail               String?
  clienteTelCountryCode      String?
  clienteTelNationalNumber   String?
  clientePreferredLanguage   ClientPreferredLanguage @default(es)
  servico            String
  serviceCodes       String[] @default([])
  status             String   @default("Não agendado")
  descricao          String
  anotInternas       String?
  anotPropriedade    String?
  endereco           Json?
  dataAgendada       String?
  horario            String?
  clientDropoffDate  String?
  clientDropoffTime  String?
  baia               Int?
  duracaoHoras       Float?
  tecnico            String?
  tecnicoStatus      String   @default("—")
  tecnicoNotas       String?
  orcamento          Json?
  anexos             Json     @default("[]")
  qa                 Json?
  agendaPreferencial String?
  log                Json     @default("[]")
  clientId           String?
  client             Client?  @relation(fields: [clientId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  payment            TaskPayment?
}

model TaskPayment {
  id               String    @id @default(uuid())
  taskId           String    @unique
  task             Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  settlementStatus String    @default("pending")
  paymentMethod    String?
  iban             String?
  amount           Float?
  isInstallment    Boolean   @default(false)
  installmentCount Int?
  installmentsPaid Int       @default(0)
  paidAt           DateTime?
  notes            String?
  updatedByUserId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([settlementStatus])
}

model Quote {
  id          String      @id @default(uuid())
  status      QuoteStatus @default(DRAFT)
  clientName                   String
  clientPhoneCountryCode       String
  clientPhoneNationalNumber    String
  clientEmail String?
  clientPreferredLanguage ClientPreferredLanguage @default(es)
  plate       String
  plateCountry String     @default("ES")
  brand       String
  model       String
  year        Int
  color       String?
  km          Int?
  vehicleSize String?
  services         Json        // array de serviços seleccionados
  serviceSnapshots Json?
  discount         Float       @default(0)
  total       Float       @default(0)
  currency    String      @default("EUR")
  notes       String?
  internalNote String?
  submittedAt DateTime?
  approvedAt  DateTime?
  createdById String?
  createdBy   User?       @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  linkedTaskDisplayId String?
  activityLog Json        @default("[]")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}